{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin-login/:path*", "destination": "/nimda-login.html" },
    { "source": "/admin-login", "destination": "/nimda-login.html" },
    { "source": "/admin/:path*", "destination": "/nimda.html" },
    { "source": "/admin", "destination": "/nimda.html" },
    { "source": "/nimda-login/:path*", "destination": "/nimda-login.html" },
    { "source": "/nimda-login", "destination": "/nimda-login.html" },
    { "source": "/nimda/:path*", "destination": "/nimda.html" },
    { "source": "/nimda", "destination": "/nimda.html" },
    { "source": "/product/:path*", "destination": "/product.html" },
    { "source": "/product", "destination": "/product.html" }
  ]
}
